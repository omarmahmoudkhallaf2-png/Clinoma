rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'admin@medprep.com'
      );
    }

    // --- 1. Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- 2. Courses & Subjects ---
    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /lectures/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 3. Exams & Questions (Formal) ---
    match /formal_exams/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow AI generation by users
    }
    match /questions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow AI question creation
    }

    // --- 4. User Progress & Attempts ---
    match /attempts/{id} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /stats/{id} {
      allow read, write: if isSignedIn() && request.auth.uid == id;
    }

    // --- 5. Notes & Bookmarks ---
    match /notes/{id} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /bookmarks/{id} {
      allow read, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // --- 6. Feedback & Errors ---
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // --- 7. Settings & Config ---
    match /config/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 8. Flashcards & Decks ---
    match /decks/{id} {
      allow read, write: if isSignedIn();
    }

    match /flashcards/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
