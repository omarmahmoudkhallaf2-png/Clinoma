rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. Helper Functions (Security Core) ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || request.auth.token.email == 'omarmahmoudkhallaf2@gmail.com');
    }

    function isEditor() {
      return isSignedIn() && (getUserData().role == 'editor' || isAdmin());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- 2. User Profiles & Progress ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- 3. Educational Content (Courses, Subjects, Lectures) ---
    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }
    
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /lectures/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    // --- 4. Question Bank & Exams ---
    match /questions/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    match /formal_exams/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    // --- 5. Results & Attempts (Privacy Protection) ---
    match /results/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /exam_attempts/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- 6. Notes & Attachments ---
    match /notes/{id} {
      allow read: if isSignedIn();
      allow write: if isEditor();
    }

    // --- 7. System Config & Logs ---
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // --- 8. Flashcards & Decks ---
    match /decks/{id} {
      allow read, write: if isSignedIn();
    }

    match /flashcards/{id} {
      allow read, write: if isSignedIn();
    }


    // --- 9. Future-Proof Catch-all Rule ---

    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
