rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow users to update their own profile, but NOT role or plan
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'isPremium']))
        || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
      
      match /activity/{activityId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Study Rooms ---
    match /study_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only host or members can update room state
      allow update: if isSignedIn() && (
        resource.data.hostId == request.auth.uid || 
        resource.data.members.keys().hasAny([request.auth.uid]) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid || isAdmin()
      );
    }

    // --- Educational Content (Read-only for users) ---
    match /video_folders/{folderId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /formal_exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Flashcards ---
    match /decks/{deckId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /flashcards/{cardId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // --- Exam Attempts ---
    match /exam_attempts/{attemptId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin(); // Only admin can modify scores after submission
    }

    // --- AI Assistant ---
    match /assistant_chats/{chatId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // --- Global Settings ---
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Fallback
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
