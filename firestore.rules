rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة للتحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // دالة للتحقق هل المستخدم أدمن أم لا
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // قواعد بيانات الطلاب
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- محتوى المذاكرة (تيمات، أسئلة، كورسات، امتحانات) ---
    // السماح بالقراءة لجميع المسجلين، والكتابة للأدمن فقط
    match /data_themes/{themeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Study Room (Realtime Collaboration) ---
    match /study_rooms/{roomId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.hostId == request.auth.uid || isAdmin()
      );
    }

    // مزامنة الوقت (Metadata)
    match /metadata/sync {
      allow read: if isSignedIn();
    }
    
    // أي مسار آخر غير محدد أعلاه متاح للأدمن فقط
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
